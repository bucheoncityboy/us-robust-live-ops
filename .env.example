# KR-Hybrid ops credentials (local only — never commit a real .env)
# Optional copy source (if present on this machine):
#   desktop/ai/엔진/.env

# KRX OpenAPI / data portal
KRX_API_KEY=
KRX_ID=
KRX_PW=

# OpenDART
DART_API_KEY=

# Toss Securities OpenAPI (portfolio read + scoped LIVE orders via ops.py execute)
TOSS_API_KEY=
TOSS_SECRET_KEY=
# Required for LIVE: exact accountSeq returned by GET /api/v1/accounts.
# Multiple brokerage accounts are blocked when this is missing.
TOSS_ACCOUNT_SEQ=

# Optional research/monthly sizing only. LIVE execute rejects capital overrides.
# OPS_CAPITAL_USD=100000
